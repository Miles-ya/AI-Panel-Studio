# Backend-local configuration. Copy this file to backend/.env; do not commit real keys.
APP_ENV=development
DATABASE_URL=sqlite:///./data/ai_panel_studio.db

# `deepseek` uses the real model. Set `fake` for a deterministic local demo or E2E run.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro

# Fake Provider only: `success` is the normal deterministic summary; `fallback_once`
# makes the first summary attempt fall back so the retry flow can be exercised.
FAKE_LLM_SUMMARY_MODE=success
