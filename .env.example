# Sensitive values are read by the backend only. Never commit real API keys or expose them to browser code.
APP_ENV=development
DATABASE_URL=sqlite:///./data/ai_panel_studio.db
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
# Set LLM_PROVIDER=fake for the deterministic local demo; it never uses an API key.
LLM_PROVIDER=deepseek
# Use fallback_once to exercise retry-summary in a local smoke test.
FAKE_LLM_SUMMARY_MODE=success
VITE_API_BASE_URL=http://127.0.0.1:8000
